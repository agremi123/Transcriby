# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ── Speechmatics ─────────────────────────────────────────────────────────────
# Get your API key at https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these at https://app.supabase.com/ → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
# Create a recurring product + price at https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
